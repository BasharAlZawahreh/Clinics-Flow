{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "install": {
      "outputs": ["node_modules/**"]
    },
    "build": {
      "dependsOn": ["install"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    }
  }
}
