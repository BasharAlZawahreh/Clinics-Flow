# Clinics-Flow - Render Environment Variables
# Copy this to Render environment variables

# ===========================================
# DATABASE (Required)
# ===========================================
# Get this from Render PostgreSQL service
# Click: PostgreSQL → "External Database URL"
DATABASE_URL=postgresql://user:password@host:port/database

# ===========================================
# JWT SECURITY (Required)
# ===========================================
# Generate a secure random string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-key-here
JWT_EXPIRES_IN=7d

# ===========================================
# API SETTINGS (Required)
# ===========================================
NODE_ENV=production
PORT=8080

# ===========================================
# OPENAI (Required for AI features)
# ===========================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ===========================================
# FRONTEND (For Web service)
# ===========================================
# Update this AFTER API deploys
NEXT_PUBLIC_API_URL=https://clinics-flow-api.onrender.com/v1

# ===========================================
# OPTIONAL: WhatsApp
# ===========================================
# If you have WhatsApp Business API
WHATSAPP_API_VERSION=v18.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token

# ===========================================
# OPTIONAL: Brave Search
# ===========================================
# Get from: https://brave.com/search/api
BRAVE_API_KEY=your-brave-api-key

# ===========================================
# OPTIONAL: Redis
# ===========================================
# If using Redis for caching/queues
REDIS_URL=redis://redis-host:6379

# ===========================================
# OPTIONAL: Development URLs (Don't set in production)
# ===========================================
# FRONTEND_URL=http://localhost:3000
# REDIS_URL=redis://localhost:6380
